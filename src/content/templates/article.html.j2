<style>
  .keg-post {
    --keg-ink: #172033;
    --keg-muted: #526173;
    --keg-line: #d9e3ea;
    --keg-blue: #2563eb;
    --keg-teal: #0f766e;
    --keg-amber: #b45309;
    --keg-soft: #f6fafc;
    color: var(--keg-ink);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 17px;
    line-height: 1.72;
    max-width: 860px;
    margin: 0 auto;
  }
  .keg-post * { box-sizing: border-box; }
  .keg-post figure { margin: 0 0 28px; }
  .keg-post h1 {
    margin: 0 0 18px;
    color: var(--keg-ink);
    font-size: 34px;
    line-height: 1.18;
  }
  .keg-post__hero {
    overflow: hidden;
    border: 1px solid var(--keg-line);
    border-radius: 18px;
    background: #f8fbfd;
    box-shadow: 0 18px 45px rgba(23, 32, 51, 0.08);
  }
  .keg-post__hero img {
    display: block;
    width: 100%;
    height: auto;
  }
  .keg-post__inline-image {
    overflow: hidden;
    margin: 30px 0;
    border: 1px solid var(--keg-line);
    border-radius: 16px;
    background: #f8fbfd;
  }
  .keg-post__inline-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .keg-post__caption {
    margin: 0;
    padding: 10px 14px;
    background: #f8fbfd;
    color: var(--keg-muted);
    font-size: 14px;
    line-height: 1.45;
  }
  .keg-post__lead {
    margin: 0 0 28px;
    padding: 20px 22px;
    border-left: 5px solid var(--keg-teal);
    border-radius: 0 14px 14px 0;
    background: #eefaf7;
    color: #1d3b43;
    font-size: 18px;
  }
  .keg-post h2 {
    margin: 40px 0 16px;
    padding-top: 8px;
    border-top: 1px solid var(--keg-line);
    color: var(--keg-ink);
    font-size: 26px;
    line-height: 1.25;
  }
  .keg-post h3 {
    margin: 24px 0 8px;
    color: #20304a;
    font-size: 20px;
    line-height: 1.35;
  }
  .keg-post p { margin: 0 0 18px; }
  .keg-post a {
    color: var(--keg-blue);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(37, 99, 235, 0.32);
  }
  .keg-post a:hover { border-bottom-color: var(--keg-blue); }
  .keg-post table {
    width: 100%;
    margin: 14px 0 26px;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--keg-line);
    border-radius: 14px;
    background: #fff;
  }
  .keg-post th,
  .keg-post td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--keg-line);
    text-align: left;
    vertical-align: top;
  }
  .keg-post th {
    background: #eaf3ff;
    color: #17335f;
    font-size: 14px;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .keg-post tr:last-child td { border-bottom: 0; }
  .keg-post ol,
  .keg-post ul {
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }
  .keg-post li {
    position: relative;
    margin: 0 0 12px;
    padding: 15px 18px 15px 46px;
    border: 1px solid var(--keg-line);
    border-radius: 14px;
    background: #fff;
  }
  .keg-post ol { counter-reset: keg-step; }
  .keg-post ol li { counter-increment: keg-step; }
  .keg-post ol li::before {
    content: counter(keg-step);
    position: absolute;
    left: 15px;
    top: 15px;
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 999px;
    background: var(--keg-teal);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .keg-post ul li::before {
    content: "";
    position: absolute;
    left: 20px;
    top: 23px;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--keg-amber);
  }
  .keg-post__sources li { padding-left: 18px; }
  .keg-post__sources li::before { display: none; }
  @media (max-width: 640px) {
    .keg-post { font-size: 16px; }
    .keg-post__lead { padding: 16px 18px; font-size: 17px; }
    .keg-post h2 { font-size: 23px; }
    .keg-post table { display: block; overflow-x: auto; }
    .keg-post th,
    .keg-post td { min-width: 180px; }
  }
</style>

<article class="keg-post">
  <h1>{{ title }}</h1>

  <figure class="keg-post__hero">
    <img src="{{ image.url or image.path }}" alt="{{ image.alt }}" loading="lazy">
  </figure>

  <p class="keg-post__lead">{{ intro }}</p>

  <h2 data-section="decision">Quick Answer</h2>
  <table>
    <tr><th>Situation</th><th>Best Choice</th></tr>
    {% for row in quick_answer %}
    <tr><td>{{ row.situation }}</td><td>{{ row.choice }}</td></tr>
    {% endfor %}
  </table>

  <h2 data-section="orientation">Before You Start</h2>
  {% for paragraph in basics %}
  <p>{{ paragraph }}</p>
  {% endfor %}

  {% if inline_images %}
  <figure class="keg-post__inline-image">
    <img src="{{ inline_images[0].url or inline_images[0].path }}" alt="{{ inline_images[0].alt }}" loading="lazy">
    <figcaption class="keg-post__caption">
      {% if inline_images[0].caption %}{{ inline_images[0].caption }}{% else %}Use this visual checkpoint before continuing with the next step.{% endif %}
    </figcaption>
  </figure>
  {% endif %}

  <h2 data-section="steps">Step-by-Step Guide</h2>
  <ol>
    {% for step in steps %}
    <li>{{ step }}</li>
    {% endfor %}
  </ol>

  {% if inline_images|length > 1 %}
  <figure class="keg-post__inline-image">
    <img src="{{ inline_images[1].url or inline_images[1].path }}" alt="{{ inline_images[1].alt }}" loading="lazy">
    <figcaption class="keg-post__caption">
      {% if inline_images[1].caption %}{{ inline_images[1].caption }}{% else %}Use this visual checklist before moving to payment or backup options.{% endif %}
    </figcaption>
  </figure>
  {% endif %}

  <h2>Costs / Payment</h2>
  <table>
    <tr><th>Item</th><th>What to Know</th></tr>
    {% for item in costs_payment %}
    <tr><td>{{ item.item }}</td><td>{{ item.detail }}</td></tr>
    {% endfor %}
  </table>

  <h2 data-section="pitfalls">Common Problems</h2>
  <ul>
    {% for mistake in mistakes %}
    <li>{{ mistake }}</li>
    {% endfor %}
  </ul>

  {% if inline_images|length > 2 %}
  <figure class="keg-post__inline-image">
    <img src="{{ inline_images[2].url or inline_images[2].path }}" alt="{{ inline_images[2].alt }}" loading="lazy">
    <figcaption class="keg-post__caption">
      {% if inline_images[2].caption %}{{ inline_images[2].caption }}{% else %}Keep this visual reminder in mind before relying on the service during your trip.{% endif %}
    </figcaption>
  </figure>
  {% endif %}

  <h2>Useful Tips for Foreign Visitors</h2>
  <table>
    <tr><th>Tip</th><th>Why It Helps</th></tr>
    {% for tip in tips %}
    <tr><td>{{ tip.title }}</td><td>{{ tip.detail }}</td></tr>
    {% endfor %}
  </table>

  <h2 data-section="faq">FAQ</h2>
  {% for item in faq %}
  <h3>{{ item.question }}</h3>
  <p>{{ item.answer }}</p>
  {% endfor %}

  <h2 data-section="related_guides">Related Guides</h2>
  <p>Continue with these closely related guides. Each link goes directly to a published article rather than a search-results page.</p>
  <ul>
    {% for item in related_guides %}
    <li><a href="{{ item.url }}">{{ item.title }}</a></li>
    {% endfor %}
  </ul>

  <h2 data-section="sources">Official Links to Check</h2>
  <p>Use these official or platform links to download apps, confirm current rules, and check live service details before you travel.</p>
  <ul class="keg-post__sources">
    {% for source in sources %}
    <li><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.name }}</a></li>
    {% endfor %}
  </ul>

  <h2 data-section="summary">Final Summary</h2>
  <p>{{ title }} is easiest when you check the official information first, prepare a backup payment or route, and save the key details before you need them. Use this guide as a practical starting point, then confirm current rules, prices, app features, and operating hours through the official links above before making travel decisions.</p>
</article>
