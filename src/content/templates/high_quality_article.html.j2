<style>
  .keg-post {
    --keg-ink: #172033;
    --keg-muted: #526173;
    --keg-line: #d9e3ea;
    --keg-blue: #2563eb;
    --keg-teal: #0f766e;
    --keg-amber: #b45309;
    color: var(--keg-ink);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 17px;
    line-height: 1.72;
    max-width: 860px;
    margin: 0 auto;
  }
  .keg-post * { box-sizing: border-box; }
  .keg-post figure { margin: 0 0 28px; }
  .keg-post__hero,
  .keg-post__inline-image {
    overflow: hidden;
    border: 1px solid var(--keg-line);
    border-radius: 18px;
    background: #f8fbfd;
  }
  .keg-post__hero { box-shadow: 0 18px 45px rgba(23, 32, 51, 0.08); }
  .keg-post__inline-image { margin: 30px 0; border-radius: 16px; }
  .keg-post img {
    display: block;
    width: 100%;
    height: auto;
  }
  .keg-post__caption {
    margin: 0;
    padding: 10px 14px;
    background: #f8fbfd;
    color: var(--keg-muted);
    font-size: 14px;
    line-height: 1.45;
  }
  .keg-post__lead {
    margin: 0 0 28px;
    padding: 20px 22px;
    border-left: 5px solid var(--keg-teal);
    border-radius: 0 14px 14px 0;
    background: #eefaf7;
    color: #1d3b43;
    font-size: 18px;
  }
  .keg-post h2 {
    margin: 40px 0 16px;
    padding-top: 8px;
    border-top: 1px solid var(--keg-line);
    color: var(--keg-ink);
    font-size: 26px;
    line-height: 1.25;
  }
  .keg-post h3 {
    margin: 24px 0 8px;
    color: #20304a;
    font-size: 20px;
    line-height: 1.35;
  }
  .keg-post p { margin: 0 0 18px; }
  .keg-post a {
    color: var(--keg-blue);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(37, 99, 235, 0.32);
  }
  .keg-post table {
    width: 100%;
    margin: 14px 0 26px;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--keg-line);
    border-radius: 14px;
    background: #fff;
  }
  .keg-post th,
  .keg-post td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--keg-line);
    text-align: left;
    vertical-align: top;
  }
  .keg-post th {
    background: #eaf3ff;
    color: #17335f;
    font-size: 14px;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .keg-post tr:last-child td { border-bottom: 0; }
  .keg-post ol,
  .keg-post ul {
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }
  .keg-post li {
    position: relative;
    margin: 0 0 12px;
    padding: 15px 18px 15px 46px;
    border: 1px solid var(--keg-line);
    border-radius: 14px;
    background: #fff;
  }
  .keg-post ol { counter-reset: keg-step; }
  .keg-post ol li { counter-increment: keg-step; }
  .keg-post ol li::before {
    content: counter(keg-step);
    position: absolute;
    left: 15px;
    top: 15px;
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border-radius: 999px;
    background: var(--keg-teal);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .keg-post ul li::before {
    content: "";
    position: absolute;
    left: 20px;
    top: 23px;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--keg-amber);
  }
  .keg-post__sources li { padding-left: 18px; }
  .keg-post__sources li::before { display: none; }
  @media (max-width: 640px) {
    .keg-post { font-size: 16px; }
    .keg-post__lead { padding: 16px 18px; font-size: 17px; }
    .keg-post h2 { font-size: 23px; }
    .keg-post table { display: block; overflow-x: auto; }
    .keg-post th,
    .keg-post td { min-width: 180px; }
  }
</style>

<article class="keg-post">
  <figure class="keg-post__hero">
    <img src="{{ image.url }}" alt="{{ image.alt }}" loading="lazy">
  </figure>

  <p class="keg-post__lead">{{ post.lead }}</p>

  <h2>Quick Answer</h2>
  <table>
    <tr><th>Situation</th><th>Best Choice</th></tr>
    {% for situation, answer in post.quick_answer %}
    <tr><td>{{ situation }}</td><td>{{ answer }}</td></tr>
    {% endfor %}
  </table>

  <h2>Before You Start</h2>
  {% for paragraph in post.before_start %}
  <p>{{ paragraph }}</p>
  {% endfor %}

  <figure class="keg-post__inline-image">
    <img src="{{ inline_image.url }}" alt="{{ inline_image.alt }}" loading="lazy">
    <figcaption class="keg-post__caption">{{ post.inline_caption }}</figcaption>
  </figure>

  <h2>Step-by-Step Guide</h2>
  <ol>
    {% for step in post.steps %}
    <li>{{ step }}</li>
    {% endfor %}
  </ol>

  <h2>Costs / Payment</h2>
  <table>
    <tr><th>Item</th><th>What to Know</th></tr>
    {% for item, detail in post.costs_payment %}
    <tr><td>{{ item }}</td><td>{{ detail }}</td></tr>
    {% endfor %}
  </table>

  <h2>Common Problems</h2>
  <ul>
    {% for problem in post.common_problems %}
    <li>{{ problem }}</li>
    {% endfor %}
  </ul>

  <h2>Useful Tips for Foreign Visitors</h2>
  <table>
    <tr><th>Tip</th><th>Why It Helps</th></tr>
    {% for tip, detail in post.tips %}
    <tr><td>{{ tip }}</td><td>{{ detail }}</td></tr>
    {% endfor %}
  </table>

  <h2>FAQ</h2>
  {% for question, answer in post.faq %}
  <h3>{{ question }}</h3>
  <p>{{ answer }}</p>
  {% endfor %}

  <h2>Official Links to Check</h2>
  <p>Use these official or platform links to download apps, confirm current rules, and check live service details before you travel.</p>
  <ul class="keg-post__sources">
    {% for name, url in post.sources %}
    <li><a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ name }}</a></li>
    {% endfor %}
  </ul>
</article>
