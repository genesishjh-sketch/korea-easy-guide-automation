# Stage 1 works without paid API keys. Add keys when you want live data.

APP_ENV=local
SITE_NAME=Korea Easy Guide
SITE_URL=https://koreaeasyguide.blogspot.com
DEFAULT_AUTHOR=Korea Easy Guide Editorial Team

# Reddit collection
# Option A: public JSON fallback, no keys needed.
# Option B: PRAW OAuth, used later if you add credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=korea-easy-guide/0.1 by yourname

# Google collection
# GOOGLE_SUGGEST uses a public suggestion endpoint. It can break or be rate-limited.
# GOOGLE_CUSTOM_SEARCH is optional and requires Google API key + CSE ID.
GOOGLE_SEARCH_PROVIDER=suggest
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Images
# PEXELS_API_KEY is optional. If missing, the pipeline generates a local SVG cover.
PEXELS_API_KEY=

# Stage 2 placeholders
BLOGGER_BLOG_ID=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_TOKEN_FILE=.credentials/google_token.json
BLOGGER_PUBLISH_MODE=draft
