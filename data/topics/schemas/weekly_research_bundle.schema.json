{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weekly_research_bundle.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "site",
    "run_id",
    "run_type",
    "started_at",
    "ended_at",
    "complete",
    "degraded",
    "stop_condition",
    "checkpoint",
    "source_coverage",
    "unexplored_scope",
    "questions",
    "clusters",
    "topics",
    "auditor",
    "synthetic_influence_count",
    "blogger_duplicate_count"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "site": {"enum": ["korea_easy_guide", "easy_pc_fix_guide"]},
    "run_id": {"type": "string", "minLength": 1},
    "run_type": {"enum": ["WEEKLY_RESEARCH", "BACKFILL_RESEARCH"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "run_at": {"type": "string", "format": "date-time"},
    "campaign_id": {"type": "string", "minLength": 1},
    "continuation_of": {"type": "string"},
    "logic_version": {"type": "string"},
    "coverage_hash": {"type": "string"},
    "coverage_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "query_family", "required", "state"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "query_family": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "state": {"enum": ["PENDING", "RUNNING", "PAUSED", "DONE", "BLOCKED", "SATURATED"]},
          "cursor": {"type": "string"},
          "attempts": {"type": "integer", "minimum": 0},
          "last_error": {"type": "string"},
          "window_start": {"type": "string"},
          "window_end": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "complete": {"type": "boolean"},
    "degraded": {"type": "boolean"},
    "collector_status": {"enum": ["SUCCESS", "DEGRADED", "FAILED"]},
    "stop_condition": {
      "enum": ["EXHAUSTED", "SATURATED", "PAUSED", "TIME_BUDGET", "SOURCE_LIMIT", "DEGRADED", "MANUAL_STOP"]
    },
    "checkpoint": {
      "type": "object",
      "required": ["cursor", "searched_scope"],
      "properties": {
        "cursor": {"type": "string"},
        "searched_scope": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"},
        "campaign_id": {"type": "string"},
        "source": {"type": "string"},
        "query_family": {"type": "string"},
        "state": {"enum": ["PENDING", "RUNNING", "PAUSED", "DONE", "BLOCKED", "SATURATED"]},
        "attempts": {"type": "integer", "minimum": 0},
        "last_error": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source_coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {"type": "number", "minimum": 0},
          {"type": "boolean"},
          {"type": "string"}
        ]
      }
    },
    "unexplored_scope": {"type": "array", "items": {"type": "string"}},
    "synthetic_influence_count": {"type": "integer", "minimum": 0},
    "blogger_duplicate_count": {"type": "integer", "minimum": 0},
    "sheet_sync_status": {"type": "string"},
    "auditor": {
      "type": "object",
      "required": [
        "passed",
        "decision",
        "auditor_id",
        "synthetic_influence_verified",
        "blogger_duplicates_verified"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "decision": {"enum": ["PASS", "HOLD", "FAIL"]},
        "auditor_id": {"type": "string", "minLength": 1},
        "evidence_url_coverage_verified": {"type": "boolean"},
        "evidence_locator_coverage_verified": {"type": "boolean"},
        "synthetic_influence_verified": {"type": "boolean"},
        "blogger_duplicates_verified": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "anyOf": [
        {"required": ["evidence_locator_coverage_verified"]},
        {"required": ["evidence_url_coverage_verified"]}
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "source", "title", "evidence_type"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_id": {"type": "string"},
          "source_item_id": {"type": "string"},
          "reddit_id": {"type": "string"},
          "external_id": {"type": "string"},
          "url": {"type": "string"},
          "permalink": {"type": "string"},
          "title": {"type": "string", "minLength": 1},
          "question": {"type": "string"},
          "summary": {"type": "string"},
          "posted_at": {"type": "string"},
          "created_at": {"type": "string"},
          "created_utc": {"type": ["string", "number"]},
          "collected_at": {"type": "string"},
          "engagement": {"type": "object", "additionalProperties": {"type": "number"}},
          "score": {"type": "number"},
          "comments": {"type": "number"},
          "upvotes": {"type": "number"},
          "views": {"type": "number"},
          "content_hash": {"type": "string"},
          "evidence_type": {
            "enum": [
              "OBSERVED_QUESTION",
              "FIRST_PARTY_QUERY",
              "SEARCH_SUGGESTION",
              "QUERY_PLAN",
              "FALLBACK_TEMPLATE"
            ]
          },
          "verification_method": {"type": "string"},
          "verified_at": {"type": "string"},
          "verified_by": {"type": "string"},
          "verified_by_codex": {"type": "boolean"},
          "property_id": {"type": "string"},
          "site_property": {"type": "string"},
          "topic_id": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cluster_id", "problem_signature", "question_ids"],
        "properties": {
          "cluster_id": {"type": "string", "minLength": 1},
          "problem_signature": {"type": "string", "minLength": 1},
          "canonical_label": {"type": "string"},
          "label": {"type": "string"},
          "question_ids": {"type": "array", "items": {"type": "string"}},
          "topic_ids": {"type": "array", "items": {"type": "string"}},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "observation_run_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "cluster_id",
          "canonical_title",
          "category_id",
          "action",
          "status",
          "question_ids",
          "official_source_urls",
          "official_source_refs",
          "official_answerable",
          "auditor_decision",
          "audited_at"
        ],
        "properties": {
          "topic_id": {"type": "string", "minLength": 1},
          "cluster_id": {"type": "string", "minLength": 1},
          "canonical_title": {"type": "string", "minLength": 1},
          "canonical_topic": {"type": "string"},
          "title": {"type": "string"},
          "seed": {"type": "string"},
          "category_id": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "canonical_intent": {"type": "string"},
          "intent": {"type": "string"},
          "problem_signature": {"type": "string"},
          "question_ids": {"type": "array", "items": {"type": "string"}},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "action": {"enum": ["NEW_POST", "UPDATE_EXISTING", "FAQ_ADD", "WATCH", "MERGE", "REJECT"]},
          "status": {"enum": ["DISCOVERED", "REVIEW", "READY", "HOLD", "STALE", "REJECTED"]},
          "priority_score": {"type": "number", "minimum": 0, "maximum": 100},
          "editor_brief": {"type": "string"},
          "reader_questions": {"type": "array", "items": {"type": "string"}},
          "difference_from_existing": {"type": "string"},
          "severity_score": {"type": "number", "minimum": 0, "maximum": 15},
          "severity_reason": {"type": "string", "minLength": 1}
          ,
          "official_source_urls": {
            "type": "array",
            "items": {"type": "string", "pattern": "^https://"}
          },
          "official_answerable": {"type": "boolean"},
          "official_source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "authority_type"],
              "properties": {
                "url": {"type": "string", "pattern": "^https://"},
                "authority_type": {
                  "enum": ["GOVERNMENT", "VENDOR", "PLATFORM", "OPERATOR", "FIRST_PARTY"]
                }
              },
              "additionalProperties": false
            }
          },
          "auditor_decision": {"enum": ["PASS", "HOLD", "FAIL"]},
          "auditor_reasons": {"type": "array", "items": {"type": "string"}},
          "audited_at": {"type": "string"},
          "evidence_exception": {
            "type": "object",
            "required": [
              "approved_by",
              "approved_at",
              "reason",
              "basis",
              "approval_source",
              "decision_id"
            ],
            "properties": {
              "approved_by": {"type": "string", "minLength": 1},
              "approved_at": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "approval_source": {"const": "USER_DECISION"},
              "decision_id": {"type": "string", "minLength": 1},
              "basis": {
                "enum": [
                  "INFORMATION_DENSITY",
                  "ENGAGEMENT",
                  "FIRST_PARTY_DEMAND",
                  "OFFICIAL_ISSUE"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "severity_score": ["severity_reason"],
          "severity_reason": ["severity_score"]
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "READY"}},
              "required": ["status"]
            },
            "then": {
              "required": [
                "editor_brief",
                "reader_questions",
                "difference_from_existing"
              ],
              "properties": {
                "editor_brief": {"minLength": 1},
                "reader_questions": {"minItems": 1},
                "difference_from_existing": {"minLength": 1},
                "official_source_refs": {"minItems": 1},
                "official_answerable": {"const": true},
                "auditor_decision": {"const": "PASS"},
                "audited_at": {"minLength": 1}
              }
            }
          }
        ]
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "topic_id"],
        "properties": {
          "question_id": {"type": "string"},
          "topic_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"complete": {"const": true}},
        "required": ["complete"]
      },
      "then": {
        "properties": {
          "degraded": {"const": false},
          "stop_condition": {"enum": ["EXHAUSTED", "SATURATED", "SOURCE_LIMIT"]},
          "unexplored_scope": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "stop_condition": {
            "enum": ["PAUSED", "TIME_BUDGET", "DEGRADED", "MANUAL_STOP"]
          }
        },
        "required": ["stop_condition"]
      },
      "then": {
        "properties": {"complete": {"const": false}}
      }
    }
  ],
  "additionalProperties": false
}
