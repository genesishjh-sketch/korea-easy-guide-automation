{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monthly_proposals.schema.json",
  "type": "object",
  "required": ["schema_version", "site", "proposals", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "site": {"type": "string"},
    "updated_at": {"type": "string"},
    "proposals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "proposal_id", "site", "kind", "payload", "reason", "status",
          "label_snapshot", "snapshot_path", "rollback_path", "rollback_audit_path",
          "label_sync_snapshot_path",
          "publication_sync_pending", "publication_sync_error", "approved_by",
          "reviewer_notes", "created_at", "approved_at", "applied_at",
          "rolled_back_at"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "site": {"type": "string"},
          "kind": {"enum": ["CREATE_CATEGORY", "RENAME_CATEGORY", "MERGE_CATEGORY", "SPLIT_CATEGORY", "LABEL_CHANGE", "MERGE_CLUSTER", "SPLIT_CLUSTER", "REASSIGN_CATEGORY"]},
          "payload": {"type": "object"},
          "reason": {"type": "string"},
          "status": {"enum": ["PROPOSED", "APPROVED", "APPLIED", "REJECTED", "ROLLED_BACK"]},
          "label_snapshot": {"type": "object"},
          "snapshot_path": {"type": "string"},
          "rollback_path": {"type": "string"},
          "rollback_audit_path": {"type": "string"},
          "label_sync_snapshot_path": {"type": "string"},
          "publication_sync_pending": {"type": "boolean"},
          "publication_sync_error": {"type": "string"},
          "approved_by": {"type": "string"},
          "reviewer_notes": {"type": "string"},
          "created_at": {"type": "string"},
          "approved_at": {"type": "string"},
          "applied_at": {"type": "string"},
          "rolled_back_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
